{
  "name": "turbocoaster",
  "private": true,
  "version": "0.1.0",
  "description": "Endless coaster runner per iOS e Android (Phaser 3 + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
